<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Colony Manager Redux and ilyvion's Laboratory are built against 4.8.1; referencing them
         from a lower target framework fails to resolve. -->
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>WorkManager</RootNamespace>
    <AssemblyName>WorkManager</AssemblyName>
    <OutputPath>..\1.6\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <!-- Colony Manager Redux and its dependencies live in the workshop install; override these
         on the command line (-p:CmrPath=...) if yours are somewhere else. -->
    <RimWorldPath>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldPath>
    <WorkshopPath>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100</WorkshopPath>
    <CmrPath>$(WorkshopPath)\3310027356\1.6\Assemblies</CmrPath>
    <LaboratoryPath>$(WorkshopPath)\3296362231\1.6\Assemblies</LaboratoryPath>
  </PropertyGroup>

  <!-- No Harmony reference: this mod extends Colony Manager Redux through its own def-driven
       extension points and patches nothing. -->

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldPath)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldPath)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ColonyManagerRedux">
      <HintPath>$(CmrPath)\ColonyManagerRedux.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0ilyvion.Laboratory">
      <HintPath>$(LaboratoryPath)\0ilyvion.Laboratory.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
    <Using Include="UnityEngine" />
    <Using Include="Verse" />
    <Using Include="RimWorld" />
    <Using Include="ColonyManagerRedux" />
    <!-- Colony Manager Redux's job API is written in terms of this alias; matching it keeps
         overrides readable and their signatures identical to the ones being overridden. -->
    <Using Include="System.Collections.Generic.IEnumerable&lt;ilyvion.Laboratory.Coroutines.IResumeCondition&gt;"
           Alias="Coroutine" />
  </ItemGroup>

</Project>
